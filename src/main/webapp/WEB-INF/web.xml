<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>tennis-court-reservation-app</display-name>

  <!-- WebSquare5 Engine Dispatcher (画面・エンジン通信用: *.wq) -->
  <servlet>
    <servlet-name>websquareDispatcher</servlet-name>
    <servlet-class>websquare.http.DefaultRequestDispatcher</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping>
    <servlet-name>websquareDispatcher</servlet-name>
    <url-pattern>*.wq</url-pattern>
  </servlet-mapping>

  <!-- *.xmlを素通りさせるとTomcatの標準サーブレットが静的ファイルとして生のXMLのまま
       返してしまい、WebSquareエンジンが画面としてレンダリングできない(以前のセッションで
       実測確認済みの問題、Docker起動時のみ手動で追加していたが未コミットだった) -->
  <servlet-mapping>
    <servlet-name>websquareDispatcher</servlet-name>
    <url-pattern>*.xml</url-pattern>
  </servlet-mapping>

</web-app>